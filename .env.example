# Required in production. Use a long random string (32+ characters).
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Required to use /admin. Do not reuse this value anywhere else.
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Public origin for sitemap, robots, and social preview URLs.
SITE_URL=http://localhost:3000

# Optional override for the JSON data file.
DATA_STORE_PATH=
